# Advisor brain. Leave the keys empty to run fully offline (local brain).
# AI_PROVIDER: auto | gemini | anthropic | local
#   auto = the whole backup chain; gemini = the two Gemini slots only; anthropic = Claude only; local = no model.
# The chain, tried in order within the same reply (an empty key is skipped quietly; see /dev/brain):
#   1. GEMINI_API_KEY with GEMINI_MODEL
#   2. GEMINI_API_KEY_2 with GEMINI_MODEL_2. Use a key from a DIFFERENT Google project (Google counts the free limit
#      per project). While it is empty, slot 2 uses GEMINI_API_KEY again with GEMINI_MODEL_2 (each model has its own
#      daily limit).
#   3. ANTHROPIC_API_KEY with ANTHROPIC_MODEL (default claude-haiku-5-5)
#   4. the built-in brain
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_2=
GEMINI_MODEL_2=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
